<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet package metadata (SDK-060): distributed as Fluxum.Sdk. -->
    <PackageId>Fluxum.Sdk</PackageId>
    <Version>0.3.0</Version>
    <Authors>HiveLLM</Authors>
    <Company>HiveLLM</Company>
    <Description>Async/await .NET client for the Fluxum realtime database: typed tables, reducer calls, and live query subscriptions over FluxRPC.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hivellm/fluxum</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hivellm/fluxum</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fluxum;realtime;database;live-queries;subscriptions;client;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Zero third-party dependencies (SDK-080). -->
  </PropertyGroup>

  <!-- README + LICENSE + icon live one level up (sdks/csharp/) so the repo
       page and the NuGet page share them; packed into the nupkg root. -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
